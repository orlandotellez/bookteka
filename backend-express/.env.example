PORT=3000
DATABASE_URL=postgres://usuario:password@localhost:5432/bookteka_db?schema=public
FRONTEND_URL=http://localhost:1420
# TRUST_BACKEND_ORIGINS=true  # solo detrás de un proxy de confianza (Docker/nginx)

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters

R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://example.r2.dev
R2_BUCKET=bookteka

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
